		<!-- main.c drives XSPI1 (HyperRAM) and XSPI2 (NOR) itself via HAL_XSPI_Init /
		     HAL_XSPIM_Config / HAL_XSPI_HyperbusCfg, and hyperram.c calls
		     HAL_XSPI_HyperbusCmd / MemoryMapped / Transmit / Receive / Abort, so the
		     XSPI HAL driver must be linked too (it was missing and broke the link). -->
		<link>
			<name>Drivers/STM32N6xx_HAL_Driver/stm32n6xx_hal_xspi.c</name>
			<type>1</type>
